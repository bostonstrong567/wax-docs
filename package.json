{
  "name": "wax-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-api.mjs && node scripts/generate-icons.mjs",
    "predev": "node scripts/generate-api.mjs && node scripts/generate-icons.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-api.mjs && node scripts/generate-icons.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-export.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check-links.mjs",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.2",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
